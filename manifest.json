{
  "manifest_version": 3,
  "name": "RSS Reader",
  "version": "1.1.0",
  "description": "Чтение RSS-новостей: настройка лент, глобальные настройки, трёхпанельный интерфейс, автозагрузка и автоочистка заголовков.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "RSS Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  }
}
